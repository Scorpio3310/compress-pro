# Canonical production origin — baked into canonicals/OG/sitemap at build time
# and compared against the request host by /robots.txt at runtime. Optional:
# builds fall back to the production URL when unset.
PUBLIC_SITE_URL=https://compress-pro.com

# Used ONLY by `pnpm dns:aid` (scripts/dns-aid.mjs) to publish the DNS-AID
# SVCB records via the Cloudflare API — unrelated to the app build. Token needs
# Zone → DNS → Edit on the compress-pro.com zone. ZONE_ID is optional (resolved
# from the zone name when unset). Never commit real values; .env* is git-ignored.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
