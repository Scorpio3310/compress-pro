{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		// The matrix classifier imports src/lib/routing.ts, which imports $lib/types.
		"baseUrl": ".",
		"paths": { "$lib/*": ["../src/lib/*"] }
	},
	"include": [
		"./**/*.ts",
		"../playwright.config.ts",
		"../playwright.bench.config.ts",
		"../playwright.matrix.config.ts",
		"../scripts/*.mjs",
		"../src/lib/ambient.d.ts"
	]
}
